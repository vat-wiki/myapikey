{
  "name": "myapikey",
  "version": "1.0.1",
  "type": "module",
  "description": "Personal LLM API gateway & proxy — one address + one API key for all your models. Forwards OpenAI & Anthropic calls to your backends with failover and a circuit breaker. Pure passthrough, no format translation. Self-hosted web UI.",
  "keywords": [
    "llm",
    "llm-gateway",
    "ai-gateway",
    "api-gateway",
    "gateway",
    "proxy",
    "llm-proxy",
    "ai-proxy",
    "llm-router",
    "model-router",
    "openai",
    "anthropic",
    "claude",
    "claude-code",
    "openai-compatible",
    "chat-completions",
    "passthrough",
    "failover",
    "circuit-breaker",
    "multi-provider",
    "self-hosted",
    "homelab",
    "hono",
    "typescript",
    "vue"
  ],
  "homepage": "https://github.com/vat-wiki/myapikey#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vat-wiki/myapikey.git"
  },
  "bugs": {
    "url": "https://github.com/vat-wiki/myapikey/issues"
  },
  "license": "MIT",
  "author": "vat-wiki",
  "bin": {
    "myapikey": "src/server/index.ts"
  },
  "files": [
    "src/server",
    "src/shared",
    "dist"
  ],
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server/index.ts",
    "dev:web": "vite src/web",
    "start": "npm run build:web && npm run serve",
    "serve": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p src/web/tsconfig.json",
    "build:web": "vite build src/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.5",
    "@hono/zod-validator": "^0.4.2",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.6.12",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.8",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
